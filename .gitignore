# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/node_modules/.vite/

# Desktop build artifacts — all under one build/ dir (Cargo/Tauri target in
